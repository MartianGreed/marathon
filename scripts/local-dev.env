# Marathon Local Development Environment Variables
# Source this file or let local-dev.sh source it automatically.
# Override any variable by exporting it before running the script.

MARATHON_ANTHROPIC_API_KEY="${MARATHON_ANTHROPIC_API_KEY:-test-key}"
MARATHON_POSTGRES_URL="${MARATHON_POSTGRES_URL:-postgresql://marathon:marathon@localhost:5432/marathon}"
MARATHON_REDIS_URL="${MARATHON_REDIS_URL:-redis://localhost:6379}"
MARATHON_NODE_ID="${MARATHON_NODE_ID:-000000000000000000000000000000f1}"
MARATHON_TOTAL_VM_SLOTS="${MARATHON_TOTAL_VM_SLOTS:-2}"

# Orchestrator connection
MARATHON_ORCHESTRATOR_ADDRESS="${MARATHON_ORCHESTRATOR_ADDRESS:-localhost}"
MARATHON_ORCHESTRATOR_PORT="${MARATHON_ORCHESTRATOR_PORT:-8080}"

# Don't set MARATHON_LISTEN_PORT — let each binary use its default
# Orchestrator defaults to 8080; node operator only dials out.

# Firecracker / VM settings (auto-detected by local-dev.sh based on /dev/kvm)
# Override these if your paths differ:
# MARATHON_FIRECRACKER_BIN=/usr/local/bin/firecracker
# MARATHON_KERNEL_PATH=/var/lib/marathon/kernel/vmlinux
# MARATHON_ROOTFS_PATH=/var/lib/marathon/rootfs/rootfs.ext4
# MARATHON_SNAPSHOT_PATH=/var/lib/marathon/snapshots
# MARATHON_WARM_POOL_TARGET=5   # set to 0 to disable VM pre-warming

MARATHON_JWT_SECRET="${MARATHON_JWT_SECRET:-local-dev-throwaway-secret-change-in-production}"
MARATHON_NODE_AUTH_KEY="${MARATHON_NODE_AUTH_KEY:-local-dev-node-key}"
