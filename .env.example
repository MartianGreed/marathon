# Marathon Configuration

# Required - Anthropic API key for Claude
MARATHON_ANTHROPIC_API_KEY=

# TLS / Traefik
MARATHON_DOMAIN=marathon.yourdomain.com
MARATHON_ACME_EMAIL=admin@yourdomain.com

# Orchestrator settings
MARATHON_ORCHESTRATOR_ADDRESS=localhost
MARATHON_ORCHESTRATOR_PORT=8080

# Node settings
# Unset: generates a random node ID; set 32 hexadecimal characters for a stable ID.
# MARATHON_NODE_ID=00000000000000000000000000000001
MARATHON_TOTAL_VM_SLOTS=4

# Database
MARATHON_POSTGRES_URL=postgresql://marathon:marathon@localhost:5432/marathon
MARATHON_REDIS_URL=redis://localhost:6379

# Docker Compose overrides (optional)
POSTGRES_USER=marathon
POSTGRES_PASSWORD=marathon
POSTGRES_DB=marathon

# GitHub integration (optional)
GITHUB_TOKEN=

# Required secrets. Replace before deployment.
MARATHON_JWT_SECRET=replace-with-random-secret
MARATHON_NODE_AUTH_KEY=replace-with-shared-node-key
MARATHON_WARM_POOL_TARGET=0
MARATHON_LISTEN_ADDRESS=0.0.0.0
MARATHON_LISTEN_PORT=8080
MARATHON_TLS_ENABLED=false
# Set true and port 443 for a Traefik TLS endpoint.
# MARATHON_METRICS_PORT=9090
